# Planning Poker Cleanup Service Configuration
# Copy this to .env and fill in your actual values
# DO NOT commit .env to version control!

# Required: Your Supabase project URL
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Required: Your Supabase Service Role key
# Get from: Supabase Dashboard → Settings → API
# ⚠️  IMPORTANT: Use the SERVICE ROLE key, NOT the anon key!
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key

# Optional: How often to run cleanup (in milliseconds)
# Default: 86400000 (24 hours)
# Examples:
#   3600000   = 1 hour
#   43200000  = 12 hours
#   86400000  = 24 hours (default)
CLEANUP_INTERVAL=86400000

# Optional: How many days to keep rooms before deletion
# Default: 30
# Examples:
#   7   = Delete rooms not updated in 7 days
#   30  = Delete rooms not updated in 30 days (default)
#   60  = Delete rooms not updated in 60 days
DAYS_TO_KEEP=30

# Optional: Enable verbose logging (for debugging)
# DEBUG=pp:cleanup
